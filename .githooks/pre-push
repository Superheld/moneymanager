#!/bin/sh
# Letzte Kontrolle, bevor etwas oeffentlich wird.
#
# Die Waechter in `npm test` sehen den ARBEITSBAUM. Was sie nicht sehen: die
# Commit-Texte. Genau dort lag beim Release 0.15.0 der groesste Teil — Kontostaende,
# Budgetbetraege und Buchungszahlen in einem Dutzend Beschreibungen, weil "am echten
# Bestand gemessen" die ueberzeugendste Begruendung ist.
#
# Deshalb hier zweierlei:
#   1. die beiden Waechter aus der Testsuite (Formen im Arbeitsbaum, Produkt-ID)
#   2. der MUSTER-Guard ueber alles, was uebertragen wird — Diff UND Commit-Texte
#
# BIS 2026-08-30 GAB ES EINEN DRITTEN: einen Abgleich der ausgehenden Commit-Texte gegen
# die ECHTE Datenbank. Er kannte die Werte und fand sie in jeder Schreibweise — das konnte
# und kann der Muster-Guard nicht. Er ist trotzdem weg, und der Grund gehoert hierher,
# damit ihn niemand aus Reflex wieder einbaut:
#
#   • Seit der Bestand verschluesselt ist, brauchte er den DATENSCHLUESSEL, abgelegt als
#     Wiederherstellungscode im Klartext neben der Datenbank. Ein Waechter, der einen
#     Generalschluessel verlangt, nimmt der Verschluesselung ihren Zweck.
#   • Fehlte die Datei, brach er ab — richtig so, aber die Folge war, dass JEDER Push
#     blockierte. Das traf auch den Rechner, auf dem die Verschluesselung eingefuehrt
#     wurde, und zwar still: ein Push, der nicht stattfindet, sieht aus wie ein Tag ohne
#     Push.
#   • Seine Voraussetzung ist entfallen: es liegen keine Echtdaten im Rohformat mehr in
#     der Entwicklung, und der Spielstand ist eine eigene Umgebung mit erfundenen Daten.
#
# WAS DAMIT UNGEPRUEFT BLEIBT: alles, was keiner Form folgt — ein Empfaengername, ein
# Verwendungszweck, eine Buchungszahl. Wer so etwas benennen kann, traegt es in
# `.privacy-terms` ein (git-ignoriert); dort greift der Muster-Guard es wieder auf. Der
# Rest ist Handarbeit, so wie die Anonymisierung es immer schon war.
#
# ERSETZEN REICHT NICHT — es muss anonymisieren. Ein erfundener Name, der die Branche
# durchscheinen laesst, verraet dasselbe wie der echte: ein Fantasiename, dem man den
# Streamingdienst ansieht, sagt immer noch, dass es so ein Abo gibt - und die Kategorie
# daneben bestaetigt es.
# Erfundene Werte sind sektorneutral, und sie gelten je TESTFALL: derselbe Fantasiename
# ueberall wird selbst zum Muster. Das prueft hier nichts nach - es ist Handarbeit.
#
# Aktiv wird der Hook durch:  git config core.hooksPath .githooks
# Umgehen im Notfall:         git push --no-verify

set -e

echo "pre-push: Waechter laufen …"
npx vitest run src/privatsphaere.test.ts src/adapters/fints/produktId.test.ts \
  --silent --reporter=dot >/dev/null || {
    echo "pre-push: ABGEBROCHEN — ein Waechter schlaegt an. Details: npx vitest run src/privatsphaere.test.ts"
    exit 1
  }

# Git schickt die ausgehenden Refs auf STDIN — und zwar genau einmal. Eingelesen wird
# deshalb EINMAL in eine Variable und danach daraus gefuettert.
#
# Gefuettert wird per Here-String und nicht per Pipe: eine Pipe startet eine Subshell, und
# ein dort gesetztes `fehler=1` ist nach der Schleife wieder weg. Der Hook liefe gruen
# durch, obwohl er angeschlagen hat.
REFS=$(cat)
WURZEL=$(git rev-parse --show-toplevel)

# Der ausgehende Bereich eines Refs — was der Remote noch NICHT hat.
#
# Bei einem bekannten Ref ist das `alt..neu`. Bei einem NEUEN Ref gibt Git als Gegenstueck
# lauter Nullen, und die naheliegende Lesart „dann eben alles" ist bei einem TAG falsch:
# ein Tag fuegt keinen Commit hinzu, er zeigt auf einen, der ueber seinen Branch laengst
# geprueft wurde. Die ganze Historie zu pruefen meldete dann jede Altlast erneut — und ein
# Waechter, der bei jedem Release dieselben alten Funde bringt, wird abgeschaltet.
#
# Deshalb wird gefragt, was DIESER Remote schon kennt. Bleibt nichts uebrig, gibt es auch
# nichts zu pruefen; sonst laeuft der Bereich ab dem Elternteil des aeltesten neuen Commits.
#
# `--remotes=$ZIEL` und nicht `--remotes`: sonst gaelte als geprueft, was auf IRGENDEINEM
# Remote liegt. Wer neben `origin` einen zweiten Fernzugriff hat — beim lib-fints-Klon ist
# das der Normalfall —, schoebe damit alles daran vorbei, was dort schon liegt und hier
# noch nicht. Eine Pruefung, die den falschen Vergleichspunkt nimmt, ist keine.
# Der Remote, zu dem gepusht wird — Git uebergibt ihn als erstes Argument. Ohne Fallback
# waere `--remotes=` leer und truege damit ALLE Remotes ein; das ist genau die Aufweichung,
# die hier vermieden werden soll.
ZIEL="${1:-origin}"

ausgehender_bereich() {
  _sha="$1" _remote="$2"
  if [ "$_remote" != "0000000000000000000000000000000000000000" ]; then
    printf '%s..%s' "$_remote" "$_sha"
    return 0
  fi
  _aeltester=$(git rev-list "$_sha" --not "--remotes=$ZIEL" 2>/dev/null | tail -1)
  [ -z "$_aeltester" ] && return 1
  if git rev-parse -q --verify "$_aeltester^" >/dev/null 2>&1; then
    printf '%s^..%s' "$_aeltester" "$_sha"
  else
    printf '%s' "$_sha"
  fi
}

guard_fehler=0
while read -r _lokal_ref lokal_sha _remote_ref remote_sha; do
  [ -z "$lokal_sha" ] && continue
  [ "$lokal_sha" = "0000000000000000000000000000000000000000" ] && continue
  bereich=$(ausgehender_bereich "$lokal_sha" "$remote_sha") || continue
  node "$WURZEL/scripts/privacy-guard.mjs" --range "$bereich" || guard_fehler=1
done <<EOF
$REFS
EOF

[ "$guard_fehler" = "0" ] || exit 1
echo "pre-push: Muster-Guard sauber."
