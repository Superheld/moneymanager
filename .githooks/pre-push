#!/bin/sh
# Letzte Kontrolle, bevor etwas oeffentlich wird.
#
# Die Waechter in `npm test` sehen den ARBEITSBAUM. Was sie nicht sehen: die
# Commit-Texte. Genau dort lag beim Release 0.15.0 der groesste Teil — Kontostaende,
# Budgetbetraege und Buchungszahlen in einem Dutzend Beschreibungen, weil "am echten
# Bestand gemessen" die ueberzeugendste Begruendung ist.
#
# Deshalb hier dreierlei:
#   1. die beiden Waechter aus der Testsuite (Datenbestand, Produkt-ID)
#   2. der MUSTER-Guard ueber alles, was uebertragen wird — Diff UND Commit-Texte
#   3. ein Abgleich der AUSGEHENDEN Commit-Texte gegen die echte Datenbank
#
# Der Muster-Guard und der Datenbank-Abgleich ersetzen einander NICHT. Der eine kennt die
# Formen (IBAN, Token, Betrag in Prosa) und findet auch Fremdes; der andere kennt die
# Werte und findet sie in jeder Schreibweise. An genau der Naht ist einmal etwas
# durchgerutscht: eine Kontonummer aus einem FinTS-Mitschnitt, die in keiner Tabelle steht.
#
# Gelesen wird ueber `sqlite3` mit `PRAGMA query_only=ON` — nicht mit `-readonly`:
# solange die App laeuft, haelt sie die Datenbank, und read-only scheitert dann mit
# "unable to open database file" (der WAL-Modus braucht die -shm-Datei). Ohne Datenbank
# oder ohne sqlite3 entfaellt Schritt 2; laesst sie sich nicht oeffnen, bricht der Hook ab
# statt stillschweigend durchzuwinken.
#
# ERSETZEN REICHT NICHT — es muss anonymisieren. Ein erfundener Name, der die Branche
# durchscheinen laesst, verraet dasselbe wie der echte: ein Fantasiename, dem man den
# Streamingdienst ansieht, sagt immer noch, dass es so ein Abo gibt - und die Kategorie
# daneben bestaetigt es.
# Erfundene Werte sind sektorneutral, und sie gelten je TESTFALL: derselbe Fantasiename
# ueberall wird selbst zum Muster. Das prueft hier nichts nach - es ist Handarbeit.
#
# Aktiv wird der Hook durch:  git config core.hooksPath .githooks
# Umgehen im Notfall:         git push --no-verify

set -e
DB="$HOME/Library/Application Support/de.netmechanics.moneymanager/moneymanager.db"

echo "pre-push: Waechter laufen …"
npx vitest run src/privatsphaere.test.ts src/adapters/fints/produktId.test.ts \
  --silent --reporter=dot >/dev/null || {
    echo "pre-push: ABGEBROCHEN — ein Waechter schlaegt an. Details: npx vitest run src/privatsphaere.test.ts"
    exit 1
  }

# Git schickt die ausgehenden Refs auf STDIN — und zwar genau einmal. Beide Pruefungen
# unten brauchen sie, deshalb wird stdin hier EINMAL eingelesen und danach aus der
# Variablen gefuettert. Wer die zweite Schleife weiter aus stdin liest, laesst sie leer
# laufen: sie sieht keinen einzigen Ref und meldet „nichts gefunden".
#
# Gefuettert wird per Here-String und nicht per Pipe: eine Pipe startet eine Subshell, und
# ein dort gesetztes `fehler=1` ist nach der Schleife wieder weg. Der Hook liefe gruen
# durch, obwohl er angeschlagen hat.
REFS=$(cat)
WURZEL=$(git rev-parse --show-toplevel)

# Der Muster-Guard laeuft ueber JEDEN ausgehenden Bereich — auch wenn es die Datenbank
# unten gar nicht gibt. Er braucht sie nicht.

# Der ausgehende Bereich eines Refs — was der Remote noch NICHT hat.
#
# Bei einem bekannten Ref ist das `alt..neu`. Bei einem NEUEN Ref gibt Git als Gegenstueck
# lauter Nullen, und die naheliegende Lesart „dann eben alles" ist bei einem TAG falsch:
# ein Tag fuegt keinen Commit hinzu, er zeigt auf einen, der ueber seinen Branch laengst
# geprueft wurde. Die ganze Historie zu pruefen meldete dann jede Altlast erneut — und ein
# Waechter, der bei jedem Release dieselben alten Funde bringt, wird abgeschaltet.
#
# Deshalb wird gefragt, was DIESER Remote schon kennt. Bleibt nichts uebrig, gibt es auch
# nichts zu pruefen; sonst laeuft der Bereich ab dem Elternteil des aeltesten neuen Commits.
#
# `--remotes=$ZIEL` und nicht `--remotes`: sonst gaelte als geprueft, was auf IRGENDEINEM
# Remote liegt. Wer neben `origin` einen zweiten Fernzugriff hat — beim lib-fints-Klon ist
# das der Normalfall —, schoebe damit alles daran vorbei, was dort schon liegt und hier
# noch nicht. Eine Pruefung, die den falschen Vergleichspunkt nimmt, ist keine.
# Der Remote, zu dem gepusht wird — Git uebergibt ihn als erstes Argument. Ohne Fallback
# waere `--remotes=` leer und truege damit ALLE Remotes ein; das ist genau die Aufweichung,
# die hier vermieden werden soll.
ZIEL="${1:-origin}"

ausgehender_bereich() {
  _sha="$1" _remote="$2"
  if [ "$_remote" != "0000000000000000000000000000000000000000" ]; then
    printf '%s..%s' "$_remote" "$_sha"
    return 0
  fi
  _aeltester=$(git rev-list "$_sha" --not "--remotes=$ZIEL" 2>/dev/null | tail -1)
  [ -z "$_aeltester" ] && return 1
  if git rev-parse -q --verify "$_aeltester^" >/dev/null 2>&1; then
    printf '%s^..%s' "$_aeltester" "$_sha"
  else
    printf '%s' "$_sha"
  fi
}

guard_fehler=0
while read -r _lokal_ref lokal_sha _remote_ref remote_sha; do
  [ -z "$lokal_sha" ] && continue
  [ "$lokal_sha" = "0000000000000000000000000000000000000000" ] && continue
  bereich=$(ausgehender_bereich "$lokal_sha" "$remote_sha") || continue
  node "$WURZEL/scripts/privacy-guard.mjs" --range "$bereich" || guard_fehler=1
done <<EOF
$REFS
EOF

[ "$guard_fehler" = "0" ] || exit 1

# Die Merkmale kommen aus `scripts/bestandsmerkmale.mjs` — DERSELBEN Quelle, aus der auch
# `src/privatsphaere.test.ts` liest.
#
# Vorher standen die Abfragen hier ein zweites Mal, und genau das ist schiefgegangen: als
# `budget.betrag_pro_monat` einer Reihe wich, zog der Test mit und dieser Hook nicht. Er
# lief danach nicht mit einem Merkmal weniger — er brach unter `set -e` wortlos ab, und
# der Push scheiterte ohne eine Zeile Begruendung. Von aussen sah das aus wie eine
# Ablehnung des Remotes, und die naheliegende Reaktion darauf ist `--no-verify`.
#
# Das Skript unterscheidet selbst zwischen „nichts zu pruefen" (leere Ausgabe, Exit 0) und
# „da ist etwas, das ich nicht lesen kann" (Abbruch mit Meldung). Beides wird hier
# uebernommen, statt es ein zweites Mal zu entscheiden.
if ! merkmale=$(node "$WURZEL/scripts/bestandsmerkmale.mjs" 2>&1); then
  echo "pre-push: ABGEBROCHEN — die Merkmale liessen sich nicht ermitteln."
  echo "          $(printf '%s' "$merkmale" | head -3)"
  echo "          Der Hook haette NICHTS geprueft. Lieber anhalten als beruhigen."
  exit 1
fi

# Keine Merkmale heisst: es gibt keinen Bestand zu schuetzen (frischer Klon, anderer
# Rechner, kein sqlite3). Der Muster-Guard oben ist da laengst gelaufen.
[ -n "$merkmale" ] || exit 0

# Gesucht wird ueber MUSTERDATEIEN, nicht in einer Schleife ueber die Werte. Zwei Gruende,
# und beide sind Fehler, die eine Schleife hier zwangslaeufig macht:
#
#   • `for wert in $merkmale` zerlegt an LEERZEICHEN. Ein Empfaenger mit zwei Wortteilen
#     wird zu zwei Suchbegriffen, und einer davon ist irgendwann ein Allerweltswort, das
#     in einem Commit-Text voellig zu Recht steht. Der Waechter meldet dann etwas, das
#     nicht da ist — und ein Waechter mit Fehlalarmen wird umgangen statt gelesen.
#   • Ein `grep` je Merkmal sind bei ueber tausend Merkmalen ebenso viele Prozesse, und
#     das je ausgehendem Ref.
#
# Zwei Dateien, weil die beiden Sorten verschieden gesucht werden: Zahlen nur an der
# Wortgrenze (sonst steckt "15000" in "150000"), Text als fester Teilstring.
TMPV=$(mktemp -d)
trap 'rm -rf "$TMPV"' EXIT INT TERM
printf '%s\n' "$merkmale" | grep -E '^[0-9.,-]+$' \
  | sed 's/[.]/\\./g; s/^/(^|[^0-9])/; s/$/([^0-9]|$)/' > "$TMPV/zahlen"
printf '%s\n' "$merkmale" | grep -vE '^[0-9.,-]+$' > "$TMPV/texte"

fehler=0
while read -r lokal_ref lokal_sha remote_ref remote_sha; do
  [ -z "$lokal_sha" ] && continue
  [ "$lokal_sha" = "0000000000000000000000000000000000000000" ] && continue
  bereich=$(ausgehender_bereich "$lokal_sha" "$remote_sha") || continue
  texte=$(git log --format='%B' "$bereich" 2>/dev/null) || continue
  # `|| true`, weil grep -c bei null Treffern mit 1 endet — unter `set -e` waere das ein
  # stiller Abbruch des ganzen Hooks, und der saehe aus wie „alles geprueft".
  n_zahlen=0
  n_texte=0
  [ -s "$TMPV/zahlen" ] && n_zahlen=$(printf '%s' "$texte" | grep -cE -f "$TMPV/zahlen" || true)
  [ -s "$TMPV/texte" ]  && n_texte=$(printf '%s' "$texte" | grep -cF -f "$TMPV/texte" || true)
  if [ "$n_zahlen" -gt 0 ] || [ "$n_texte" -gt 0 ]; then
    echo "pre-push: ABGEBROCHEN — ein Wert aus dem echten Bestand steht in einem Commit-Text ($lokal_ref)."
    echo "          Bereich $bereich, betroffene Zeilen: $((n_zahlen + n_texte))."
    echo "          Der Wert wird hier bewusst NICHT ausgegeben — diese Ausgabe landet in"
    echo "          Protokollen. Sichtbar machen mit:"
    echo "            node scripts/bestandsmerkmale.mjs > /tmp/m && \\"
    echo "              git log --format='%B' $bereich | grep -nFf /tmp/m; rm /tmp/m"
    fehler=1
  fi
done <<EOF
$REFS
EOF

[ "$fehler" = "0" ] || exit 1
echo "pre-push: nichts aus dem echten Bestand in den ausgehenden Commit-Texten."
