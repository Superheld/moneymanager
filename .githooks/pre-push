#!/bin/sh
# Letzte Kontrolle, bevor etwas oeffentlich wird.
#
# Die Waechter in `npm test` sehen den ARBEITSBAUM. Was sie nicht sehen: die
# Commit-Texte. Genau dort lag beim Release 0.15.0 der groesste Teil — Kontostaende,
# Budgetbetraege und Buchungszahlen in einem Dutzend Beschreibungen, weil "am echten
# Bestand gemessen" die ueberzeugendste Begruendung ist.
#
# Deshalb hier zweierlei:
#   1. die beiden Waechter aus der Testsuite (Datenbestand, Produkt-ID)
#   2. ein Abgleich der AUSGEHENDEN Commit-Texte gegen die echte Datenbank
#
# Gelesen wird ueber `sqlite3` mit `PRAGMA query_only=ON` — nicht mit `-readonly`:
# solange die App laeuft, haelt sie die Datenbank, und read-only scheitert dann mit
# "unable to open database file" (der WAL-Modus braucht die -shm-Datei). Ohne Datenbank
# oder ohne sqlite3 entfaellt Schritt 2; laesst sie sich nicht oeffnen, bricht der Hook ab
# statt stillschweigend durchzuwinken.
#
# ERSETZEN REICHT NICHT — es muss anonymisieren. Ein erfundener Name, der die Branche
# durchscheinen laesst, verraet dasselbe wie der echte: ein Fantasiename, dem man den
# Streamingdienst ansieht, sagt immer noch, dass es so ein Abo gibt - und die Kategorie
# daneben bestaetigt es.
# Erfundene Werte sind sektorneutral, und sie gelten je TESTFALL: derselbe Fantasiename
# ueberall wird selbst zum Muster. Das prueft hier nichts nach - es ist Handarbeit.
#
# Aktiv wird der Hook durch:  git config core.hooksPath .githooks
# Umgehen im Notfall:         git push --no-verify

set -e
DB="$HOME/Library/Application Support/de.netmechanics.moneymanager/moneymanager.db"

echo "pre-push: Waechter laufen …"
npx vitest run src/privatsphaere.test.ts src/adapters/fints/produktId.test.ts \
  --silent --reporter=dot >/dev/null || {
    echo "pre-push: ABGEBROCHEN — ein Waechter schlaegt an. Details: npx vitest run src/privatsphaere.test.ts"
    exit 1
  }

[ -f "$DB" ] || exit 0
command -v sqlite3 >/dev/null || exit 0

# Merkmale aus der echten Datenbank: Betraege in beiden Schreibweisen und in Cent.
lesen() { sqlite3 -cmd "PRAGMA query_only=ON" "$DB" "$1" 2>/dev/null; }

if ! lesen "SELECT count(*) FROM sqlite_master;" >/dev/null; then
  echo "pre-push: ABGEBROCHEN — die Datenbank ist da, laesst sich aber nicht lesen."
  echo "          Der Hook haette NICHTS geprueft. Lieber anhalten als beruhigen."
  exit 1
fi

# Jede Tabelle EINZELN: eine Spalte, die es nicht (mehr) gibt, wuerde sonst die ganze
# Abfrage kippen — und der Hook liefe mit leerer Merkmalsliste gruen durch.
roh=$(for sql in \
    "SELECT kontostand FROM zahlungskonto" \
    "SELECT betrag_pro_monat FROM budget" \
    "SELECT betrag FROM kontostand_anker" \
    "SELECT sum(betrag) FROM ist_buchung GROUP BY konto_id"; do
  lesen "$sql;"
done)

merkmale=$(printf '%s\n' "$roh" \
  | awk '{ c = $1 < 0 ? -$1 : $1
           if (c < 1000) next
           printf "%d\n", $1
           euro = sprintf("%d", c/100); rest = sprintf("%02d", c%100)
           printf "%s,%s\n", euro, rest
           mit = ""
           while (length(euro) > 3) {
             mit = "." substr(euro, length(euro)-2) mit
             euro = substr(euro, 1, length(euro)-3)
           }
           printf "%s%s,%s\n", euro, mit, rest }' | sort -u)

if [ -z "$merkmale" ]; then
  echo "pre-push: ABGEBROCHEN — aus der Datenbank kam KEIN einziges Merkmal."
  echo "          Entweder ist sie leer, oder die Abfragen passen nicht mehr zum Schema."
  echo "          So oder so haette der Hook nichts geprueft."
  exit 1
fi

# Dazu Kennungen: IBANs und Personennamen.
kennungen=$(lesen "SELECT iban FROM zahlungskonto WHERE iban IS NOT NULL AND iban <> ''
  UNION SELECT name FROM person;" | awk 'length($0) >= 8')

fehler=0
while read -r lokal_ref lokal_sha remote_ref remote_sha; do
  [ "$lokal_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    bereich="$lokal_sha"
  else
    bereich="$remote_sha..$lokal_sha"
  fi
  texte=$(git log --format='%B' "$bereich" 2>/dev/null) || continue
  for wert in $merkmale $kennungen; do
    # Zahlen an der Wortgrenze pruefen: sonst schlaegt "15000" in "150000" an, und ein
    # Waechter mit Fehlalarmen wird umgangen statt gelesen.
    case "$wert" in
      *[!0-9.,]*) treffer=$(printf '%s' "$texte" | grep -cF -- "$wert") ;;
      *)          treffer=$(printf '%s' "$texte" | grep -cE "(^|[^0-9])$wert([^0-9]|$)") ;;
    esac
    if [ "$treffer" -gt 0 ]; then
      echo "pre-push: ABGEBROCHEN — ein Wert aus dem echten Bestand steht in einem Commit-Text ($lokal_ref)."
      echo "          Laenge $(printf '%s' "$wert" | wc -c | tr -d ' '), gefunden im Bereich $bereich."
      echo "          Der Wert wird hier bewusst nicht ausgegeben. Suche ihn mit:"
      echo "            git log --format='%B' $bereich | grep -nF \"\$(sqlite3 -readonly \"\$DB\" '…')\""
      fehler=1
    fi
  done
done

[ "$fehler" = "0" ] || exit 1
echo "pre-push: nichts aus dem echten Bestand in den ausgehenden Commit-Texten."
