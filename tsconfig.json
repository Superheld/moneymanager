{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    /* ES2022.Error und sonst nichts aus ES2022: `new Error(msg, { cause })` verkettet
       Fehler, ohne die urspruengliche Ursache in eine Textnachricht zu quetschen. Nur
       dieser eine Baustein statt der ganzen ES2022-Bibliothek — was der Compiler
       zulaesst, wird irgendwann benutzt, und das Ziel bleibt bewusst ES2020. */
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    /* TypeScript 7 zieht @types/* nicht mehr von selbst herein — was global gelten soll,
       steht hier. Alles andere (React, sql.js …) kommt ohnehin über die Importe. */
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
